{
  "manifest_version": 3,
  "name": "Browser Vim Basics",
  "version": "0.1.1",
  "description": "Neovim-style tab switching and link hints.",
  "permissions": ["tabs"],
  "action": {
    "default_title": "Browser Vim Basics status",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ]
}
