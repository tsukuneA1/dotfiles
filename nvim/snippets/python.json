  "atcoder: UnionFind": {
    "prefix": "atuf",
    "description": "UnionFind (経路圧縮 + union by size, 非再帰)",
    "body": [
      "class UnionFind:",
      "  def __init__(self, n):",
      "    self.p = [-1]*n  # 負なら根、絶対値が連結成分サイズ",
      "",
      "  def find(self, x):",
      "    r = x",
      "    while self.p[r] >= 0:",
      "      r = self.p[r]",
      "    while self.p[x] >= 0:  # 経路圧縮",
      "      self.p[x], x = r, self.p[x]",
      "    return r",
      "",
      "  def unite(self, x, y):",
      "    x, y = self.find(x), self.find(y)",
      "    if x == y:",
      "      return False",
      "    if self.p[x] > self.p[y]:  # サイズが大きい方を根に",
      "      x, y = y, x",
      "    self.p[x] += self.p[y]",
      "    self.p[y] = x",
      "    return True",
      "",
      "  def same(self, x, y):",
      "    return self.find(x) == self.find(y)",
      "",
      "  def size(self, x):",
      "    return -self.p[self.find(x)]",
      "$0"
    ]
  },
  "atcoder: BIT (Fenwick Tree)": {
    "prefix": "atbit",
    "description": "BIT: 一点加算 + 区間和 O(log N)",
    "body": [
      "class BIT:",
      "  def __init__(self, n):",
      "    self.n = n",
      "    self.d = [0]*(n+1)",
      "",
      "  def add(self, i, x):  # 0-indexed",
      "    i += 1",
      "    while i <= self.n:",
      "      self.d[i] += x",
      "      i += i & -i",
      "",
      "  def sum(self, r):  # [0, r) の和",
      "    s = 0",
      "    while r > 0:",
      "      s += self.d[r]",
      "      r -= r & -r",
      "    return s",
      "",
      "  def range_sum(self, l, r):  # [l, r)",
      "    return self.sum(r) - self.sum(l)",
      "$0"
    ]
  },
  "atcoder: Dijkstra": {
    "prefix": "atdij",
    "description": "ダイクストラ法 (heapq, 遅延削除)",
    "body": [
      "import heapq",
      "",
      "def dijkstra(g, s, n):  # g[v] = [(to, cost), ...]",
      "  INF = 1 << 60",
      "  dist = [INF]*n",
      "  dist[s] = 0",
      "  hq = [(0, s)]",
      "  while hq:",
      "    d, v = heapq.heappop(hq)",
      "    if d > dist[v]:",
      "      continue",
      "    for to, c in g[v]:",
      "      if dist[to] > d + c:",
      "        dist[to] = d + c",
      "        heapq.heappush(hq, (dist[to], to))",
      "  return dist",
      "$0"
    ]
  },
  "atcoder: factorial table + nCr": {
    "prefix": "atncr",
    "description": "階乗・逆元テーブル + nCr (mod)",
    "body": [
      "MOD = ${1:998244353}",
      "MX = 2*10**5 + 10",
      "fact = [1]*MX",
      "for i in range(1, MX):",
      "  fact[i] = fact[i-1]*i % MOD",
      "finv = [1]*MX",
      "finv[MX-1] = pow(fact[MX-1], MOD-2, MOD)",
      "for i in range(MX-1, 0, -1):",
      "  finv[i-1] = finv[i]*i % MOD",
      "",
      "def nCr(n, r):",
      "  if r < 0 or r > n:",
      "    return 0",
      "  return fact[n]*finv[r] % MOD * finv[n-r] % MOD",
      "$0"
    ]
  },
  "atcoder: iterative DFS (order + par)": {
    "prefix": "atdfs",
    "description": "非再帰DFS: 行きがけ順を記録し reversed で帰りがけ処理",
    "body": [
      "# 行きがけ順を order に記録 -> reversed(order) が帰りがけ順になる",
      "order, par = [], [-1]*n",
      "seen = [False]*n",
      "st = [${1:0}]",
      "seen[${1:0}] = True",
      "while st:",
      "  v = st.pop()",
      "  order.append(v)",
      "  for to in g[v]:",
      "    if not seen[to]:",
      "      seen[to] = True",
      "      par[to] = v",
      "      st.append(to)",
      "",
      "# 帰りがけ (子が先に処理済み): 部分木サイズ・木DP",
      "sub = [1]*n",
      "for v in reversed(order):",
      "  if par[v] >= 0:",
      "    sub[par[v]] += sub[v]",
      "$0"
    ]
  },
  "atcoder: BFS on graph": {
    "prefix": "atbfs",
    "description": "グラフBFS (dist を -1 初期化して訪問管理と兼用)",
    "body": [
      "from collections import deque",
      "",
      "dist = [-1]*n",
      "dist[${1:0}] = 0",
      "q = deque([${1:0}])",
      "while q:",
      "  v = q.popleft()",
      "  for to in g[v]:",
      "    if dist[to] == -1:",
      "      dist[to] = dist[v] + 1  # append する時点で訪問済みにする",
      "      q.append(to)",
      "$0"
    ]
  },
