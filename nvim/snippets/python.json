  "atcoder: sieve (smallest prime factor)": {
    "prefix": "atsieve",
    "description": "エラトステネス (最小素因数テーブル) + O(log N) 素因数分解",
    "body": [
      "def sieve(n):  # spf[x] = x の最小素因数",
      "  spf = list(range(n+1))",
      "  i = 2",
      "  while i*i <= n:",
      "    if spf[i] == i:",
      "      for j in range(i*i, n+1, i):",
      "        if spf[j] == j:",
      "          spf[j] = i",
      "    i += 1",
      "  return spf",
      "",
      "def factorize_spf(x, spf):",
      "  res = {}",
      "  while x > 1:",
      "    p = spf[x]",
      "    while x % p == 0:",
      "      res[p] = res.get(p, 0) + 1",
      "      x //= p",
      "  return res",
      "$0"
    ]
  },
  "atcoder: trial division factorize": {
    "prefix": "atfact",
    "description": "試し割り素因数分解 O(sqrt N)",
    "body": [
      "def factorize(n):",
      "  res = {}",
      "  d = 2",
      "  while d*d <= n:",
      "    while n % d == 0:",
      "      res[d] = res.get(d, 0) + 1",
      "      n //= d",
      "    d += 1",
      "  if n > 1:",
      "    res[n] = res.get(n, 0) + 1",
      "  return res",
      "$0"
    ]
  },
